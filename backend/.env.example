DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dinner_service
DB_USER=dinner_app
DB_PASSWORD=change-me
CORS_ALLOW_ORIGINS=http://localhost:5173
APP_ENV=dev
APP_PORT=8000
# 로그인 세션 쿠키. http 로컬 개발은 false, ngrok 등 https 로 공개하면 true
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=14
# 공개 회원가입(POST /auth/signup). false 면 403, 계정은 CLI(manage_users)로만 만든다
ALLOW_SIGNUP=true
